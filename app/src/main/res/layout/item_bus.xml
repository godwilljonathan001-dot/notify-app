<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp"
    app:cardBackgroundColor="@color/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="56dp"
                android:layout_height="56dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/colorPrimaryContainer">
                <ImageView
                    android:id="@+id/imgBusIcon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@android:drawable/ic_dialog_map"
                    android:padding="12dp"
                    app:tint="@color/colorPrimary" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvBusNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bus #000"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorOnSurface" />

                <TextView
                    android:id="@+id/tvBusStatusDetail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Parked at Depot"
                    android:textSize="12sp"
                    android:textColor="@color/gray_dark" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardBusStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#F5F5F5">
                <TextView
                    android:id="@+id/tvBusStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:text="Parked"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/gray_dark" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#F1F3F5"
            android:layout_marginVertical="16dp" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:rowCount="2">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DRIVER"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/gray_dark"
                    android:letterSpacing="0.05" />
                <TextView
                    android:id="@+id/tvBusDriver"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Unassigned"
                    android:textSize="13sp"
                    android:textColor="@color/colorOnSurface" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LOAD"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/gray_dark"
                    android:letterSpacing="0.05" />
                <TextView
                    android:id="@+id/tvBusLoad"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 / 30"
                    android:textSize="13sp"
                    android:textColor="@color/colorOnSurface" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CAPACITY"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/gray_dark"
                    android:letterSpacing="0.05" />
                <TextView
                    android:id="@+id/tvBusCapacity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="30 Seats"
                    android:textSize="13sp"
                    android:textColor="@color/colorOnSurface" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="2"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CURRENT STOP"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/gray_dark"
                    android:letterSpacing="0.05" />
                <TextView
                    android:id="@+id/tvBusStop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Terminal A"
                    android:textSize="13sp"
                    android:textColor="@color/colorOnSurface" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:gravity="end|center_vertical">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnManageBus"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Manage"
                    android:textSize="12sp"
                    android:textColor="@color/colorPrimary"
                    android:padding="0dp"
                    app:icon="@android:drawable/ic_menu_edit"
                    app:iconSize="16dp" />
            </LinearLayout>

        </GridLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
