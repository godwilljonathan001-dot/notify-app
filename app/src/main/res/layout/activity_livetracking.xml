<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:elevation="0dp"
        android:background="@color/white">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@android:drawable/ic_menu_revert"
            app:title="Fleet Control Center"
            app:titleTextColor="@color/black"
            app:titleCentered="true">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_gravity="end"
                android:layout_marginEnd="16dp"
                android:gravity="center_vertical">

                <View
                    android:id="@+id/indicatorConnection"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@android:drawable/presence_online"
                    android:layout_marginEnd="6dp"/>

                <TextView
                    android:id="@+id/tvSyncTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Live Sync"
                    android:textSize="11sp"
                    android:textColor="@color/gray_dark"/>
            </LinearLayout>
        </com.google.android.material.appbar.MaterialToolbar>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="12dp">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:startIconDrawable="@android:drawable/ic_menu_search"
                app:boxCornerRadiusTopStart="28dp"
                app:boxCornerRadiusTopEnd="28dp"
                app:boxCornerRadiusBottomStart="28dp"
                app:boxCornerRadiusBottomEnd="28dp"
                app:boxStrokeWidth="0dp"
                app:boxStrokeWidthFocused="0dp"
                app:hintEnabled="false"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etSearch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Search Fleet (Bus, Driver, Route...)"
                    android:inputType="text"
                    android:background="@color/colorSurface"
                    android:paddingVertical="10dp"
                    android:textSize="14sp"/>
            </com.google.android.material.textfield.TextInputLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none">
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupFilters"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleSelection="true">
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipAll"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="All Fleet"
                        android:checked="true"/>
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipRunning"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Running"/>
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipParked"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Parked"/>
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <fragment
            android:id="@+id/map"
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Floating Operational Dashboard -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="#CCFFFFFF">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="center">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView
                        android:id="@+id/tvActiveBuses"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/status_green"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ACTIVE"
                        android:textSize="9sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <View android:layout_width="1dp" android:layout_height="24dp" android:background="#E0E0E0"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView
                        android:id="@+id/tvParkedBuses"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/gray_dark"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PARKED"
                        android:textSize="9sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <View android:layout_width="1dp" android:layout_height="24dp" android:background="#E0E0E0"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView
                        android:id="@+id/tvTotalPassengers"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorPrimary"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PASSENGERS"
                        android:textSize="9sp"
                        android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Map Controls -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="12dp">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btnMapType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:fabCustomSize="40dp"
                app:elevation="4dp"
                android:src="@android:drawable/ic_menu_mapmode"
                app:tint="@color/gray_dark"
                app:backgroundTint="@color/white"
                android:contentDescription="Map Type"/>

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btnTraffic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:fabCustomSize="40dp"
                app:elevation="4dp"
                android:src="@android:drawable/ic_menu_directions"
                app:tint="@color/gray_dark"
                app:backgroundTint="@color/white"
                android:contentDescription="Traffic Toggle"/>

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btnLocateFleet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:fabCustomSize="48dp"
                app:elevation="6dp"
                android:src="@android:drawable/ic_menu_compass"
                app:tint="@color/white"
                app:backgroundTint="@color/colorPrimary"
                android:contentDescription="Locate Fleet"/>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRecenter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="32dp"
            android:text="Re-center Fleet"
            android:visibility="gone"
            app:cornerRadius="24dp"
            app:icon="@android:drawable/ic_menu_mylocation"
            app:backgroundTint="@color/colorOnSurface"/>

    </FrameLayout>

    <!-- Selection Bottom Sheet -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottomSheetBus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="32dp"
        app:cardElevation="24dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="@color/colorSurface"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <View
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:background="#E0E0E0"
                android:layout_marginBottom="20dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/colorPrimaryContainer">
                    <ImageView
                        android:id="@+id/imgSelectedBus"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@android:drawable/ic_dialog_map"
                        android:padding="12dp"
                        app:tint="@color/colorPrimary" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tvSheetBusNum"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bus #---"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorOnSurface" />
                    <TextView
                        android:id="@+id/tvSheetDriver"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Driver Name"
                        android:textSize="14sp"
                        android:textColor="@color/gray_dark" />
                </LinearLayout>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSheetStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Running"
                    style="@style/Widget.Material3.Chip.Assist"
                    app:chipBackgroundColor="#E8F5E9"
                    android:textColor="@color/status_green"/>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F1F3F5" android:layout_marginVertical="20dp"/>

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:rowCount="3">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical" android:layout_marginBottom="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ROUTE" android:textSize="10sp" android:textStyle="bold" android:textColor="@color/gray_dark" android:letterSpacing="0.05"/>
                    <TextView android:id="@+id/tvSheetRoute" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="---" android:textSize="15sp" android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical" android:layout_marginBottom="16dp" android:gravity="end">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LOAD" android:textSize="10sp" android:textStyle="bold" android:textColor="@color/gray_dark" android:letterSpacing="0.05"/>
                    <TextView android:id="@+id/tvSheetLoad" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 / 30" android:textSize="15sp" android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical" android:layout_marginBottom="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SPEED" android:textSize="10sp" android:textStyle="bold" android:textColor="@color/gray_dark" android:letterSpacing="0.05"/>
                    <TextView android:id="@+id/tvSheetSpeed" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 km/h" android:textSize="15sp" android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical" android:layout_marginBottom="16dp" android:gravity="end">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LAST UPDATE" android:textSize="10sp" android:textStyle="bold" android:textColor="@color/gray_dark" android:letterSpacing="0.05"/>
                    <TextView android:id="@+id/tvSheetUpdate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Just now" android:textSize="15sp" android:textStyle="bold"/>
                </LinearLayout>
            </GridLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFollowBus"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:text="Engage Follow Mode"
                app:cornerRadius="16dp"
                app:icon="@android:drawable/ic_menu_compass" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- AI Operational Insights Overlay (Optional/Toggle) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardAiInsights"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:visibility="gone"
        app:cardCornerRadius="20dp"
        app:cardElevation="12dp"
        app:strokeWidth="1dp"
        app:strokeColor="#D3E4FF"
        app:cardBackgroundColor="#F0F4FF">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✨ Operational Intelligence"
                android:textStyle="bold"
                android:textSize="13sp"
                android:textColor="@color/colorPrimary" />
            <TextView
                android:id="@+id/tvAiFleetInsights"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Analyzing fleet activity..."
                android:layout_marginTop="8dp"
                android:textSize="12sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
